import os
import uuid
import threading
import pygame
from gtts import gTTS
from jarvis.common.logger import setup_logger

logger = setup_logger()

class GoogleSpeaker:
    def __init__(self, lang="en", tld="co.uk"):
        self.lang = lang
        self.tld = tld
        self.speech_lock = threading.Lock()
        
        if not pygame.mixer.get_init():
            pygame.mixer.init()

    def _speak_thread(self, text: str):
        with self.speech_lock:
            filename = f"tts_{uuid.uuid4().hex}.mp3"
            try:
                # 1. Primary Option: Online Google Cloud Speech
                tts = gTTS(text=text, lang=self.lang, tld=self.tld)
                tts.save(filename)
                
                pygame.mixer.music.load(filename)
                pygame.mixer.music.play()
                
                while pygame.mixer.music.get_busy():
                    pygame.time.Clock().tick(10)
                    
            except Exception as cloud_error:
                logger.warning(f"Google TTS failed (likely offline). Switching to local fallback: {cloud_error}")
                # 2. Secondary Option: Offline Fallback Engine
                self._fallback_speak(text)
                
            finally:
                pygame.mixer.music.unload() 
                if os.path.exists(filename):
                    os.remove(filename)

    def _fallback_speak(self, text: str):
        """Offline fallback executed if cloud TTS fails."""
        try:
            import pyttsx3
            engine = pyttsx3.init()
            engine.say(text)
            engine.runAndWait()
        except Exception as local_error:
            logger.error(f"Offline fallback TTS Error: {local_error}")

    def speak(self, text: str):
        if not text or not text.strip():
            return
        threading.Thread(target=self._speak_thread, args=(text.strip(),), daemon=True).start()




       # ESP8266 CODE - #include <WiFi.h>
#include <WebServer.h>
#include <ESPmDNS.h>
#include <Wire.h>
#include <Adafruit_PCF8574.h>
#include <WiFiManager.h>

// --- ST7735 DISPLAY LIBRARIES ---
#include <Adafruit_GFX.h>
#include <Adafruit_ST7735.h>
#include <SPI.h>

WebServer server(80);
Adafruit_PCF8574 pcf;

// ==========================================
// PIN DEFINITIONS (ESP32 38-PIN)
// ==========================================
// PCF8574 I2C Pins (Hardware Default)
#define SDA_PIN 21 
#define SCL_PIN 22 

// PCF8574 Expander Motor Pins (P0 to P7)
#define IN1      0 // Left Motor Dir 1
#define IN2      1 // Left Motor Dir 2
#define IN3      2 // Right Motor Dir 1
#define IN4      3 // Right Motor Dir 2

// ST7735 Display Pins (Hardware VSPI: MOSI=23, SCLK=18)
#define TFT_CS   5  
#define TFT_RST  4  
#define TFT_DC   19 

// Ultrasonic Sensor Pins
#define TRIG_PIN 13
#define ECHO_PIN 33

Adafruit_ST7735 tft = Adafruit_ST7735(TFT_CS, TFT_DC, TFT_RST);

// ==========================================
// ANIMATION & STATE VARIABLES
// ==========================================
uint16_t currentEyeColor = ST7735_CYAN;

bool isSpeaking = false;
bool isBlinking = false;
bool mouthOpen = false;

// Timers for non-blocking animation
unsigned long lastBlinkTime = 0;
unsigned long blinkDuration = 150;        // Blink lasts 150ms
unsigned long nextBlinkInterval = 4000;   // Initial blink interval (4s)
unsigned long lastTalkAnimTime = 0;
const int talkAnimInterval = 120;         // Mouth toggles every 120ms when speaking

// ==========================================
// JARVIS FACE DRAWING LOGIC
// ==========================================
void drawJarvisFace(uint16_t color, bool blinking, bool speaking, bool openMouth) {
  tft.fillScreen(ST7735_BLACK); // Clear screen

  if (blinking) {
    // Blinking Eyes (Horizontal Lines)
    tft.drawFastHLine(20, 40, 45, color);
    tft.drawFastHLine(20, 41, 45, color); 
    tft.drawFastHLine(95, 40, 45, color);
    tft.drawFastHLine(95, 41, 45, color);
  } else {
    // Left Eye
    tft.fillTriangle(25, 20,  70, 25,  60, 55, color);
    tft.fillTriangle(25, 20,  60, 55,  25, 48, color);

    // Right Eye
    tft.fillTriangle(90, 25, 135, 20, 135, 48, color);
    tft.fillTriangle(90, 25, 135, 48, 100, 55, color);
  }

  // Mouth Section
  if (speaking) {
    if (openMouth) {
      // Equalizer bars when talking
      tft.fillRect(65, 75, 7, 15, color);
      tft.fillRect(76, 70, 8, 25, color);
      tft.fillRect(88, 75, 7, 15, color);
    } else {
      // Small mouth bars
      tft.fillRect(65, 80, 7, 5, color);
      tft.fillRect(76, 78, 8, 9, color);
      tft.fillRect(88, 80, 7, 5, color);
    }
  } else {
    // Resting Mouth Line
    tft.fillRect(65, 82, 30, 3, color);
  }
}

// ==========================================
// NON-BLOCKING ANIMATION ENGINE
// ==========================================
void updateFaceAnimation() {
  unsigned long currentMillis = millis();
  bool needsRedraw = false;

  // 1. Idle Random Blinking
  if (!isBlinking && (currentMillis - lastBlinkTime >= nextBlinkInterval)) {
    isBlinking = true;
    lastBlinkTime = currentMillis;
    needsRedraw = true;
  } else if (isBlinking && (currentMillis - lastBlinkTime >= blinkDuration)) {
    isBlinking = false;
    lastBlinkTime = currentMillis;
    nextBlinkInterval = random(2500, 6000); // Set next random blink time (2.5s to 6s)
    needsRedraw = true;
  }

  // 2. Mouth Equalizer Movement When Speaking
  if (isSpeaking && (currentMillis - lastTalkAnimTime >= talkAnimInterval)) {
    lastTalkAnimTime = currentMillis;
    mouthOpen = !mouthOpen;
    needsRedraw = true;
  } else if (!isSpeaking && mouthOpen) {
    mouthOpen = false;
    needsRedraw = true;
  }

  // Redraw face only when an animation frame state changes
  if (needsRedraw) {
    drawJarvisFace(currentEyeColor, isBlinking, isSpeaking, mouthOpen);
  }
}

// ==========================================
// MOTOR CONTROL LOGIC
// ==========================================
void stopMotors() {
  pcf.digitalWrite(IN1, LOW);
  pcf.digitalWrite(IN2, LOW);
  pcf.digitalWrite(IN3, LOW);
  pcf.digitalWrite(IN4, LOW);
}

void moveForward() {
  pcf.digitalWrite(IN1, HIGH);
  pcf.digitalWrite(IN2, LOW);
  pcf.digitalWrite(IN3, HIGH);
  pcf.digitalWrite(IN4, LOW);
}

void moveBackward() {
  pcf.digitalWrite(IN1, LOW);
  pcf.digitalWrite(IN2, HIGH);
  pcf.digitalWrite(IN3, LOW);
  pcf.digitalWrite(IN4, HIGH);
}

void turnLeft() {
  pcf.digitalWrite(IN1, LOW);
  pcf.digitalWrite(IN2, HIGH);
  pcf.digitalWrite(IN3, HIGH);
  pcf.digitalWrite(IN4, LOW);
}

void turnRight() {
  pcf.digitalWrite(IN1, HIGH);
  pcf.digitalWrite(IN2, LOW);
  pcf.digitalWrite(IN3, LOW);
  pcf.digitalWrite(IN4, HIGH);
}

// ==========================================
// WEB SERVER HANDLERS
// ==========================================
void handleMove() {
  if (!server.hasArg("dir")) {
    server.send(400, "text/plain", "Error: Missing 'dir' parameter");
    return;
  }

  String direction = server.arg("dir");

  if (direction == "forward") moveForward();
  else if (direction == "backward") moveBackward();
  else if (direction == "left") turnLeft();
  else if (direction == "right") turnRight();
  else if (direction == "stop") stopMotors();
  else {
    server.send(400, "text/plain", "Error: Invalid direction");
    return;
  }

  server.send(200, "text/plain", "Motor command executed");
}

void handleEyes() {
  if (server.hasArg("r") && server.hasArg("g") && server.hasArg("b")) {
    int r = server.arg("r").toInt();
    int g = server.arg("g").toInt();
    int b = server.arg("b").toInt();
    
    currentEyeColor = tft.color565(r, g, b);
    drawJarvisFace(currentEyeColor, isBlinking, isSpeaking, mouthOpen);
    
    server.send(200, "text/plain", "Eye color updated");
  } else {
    server.send(400, "text/plain", "Error: Missing RGB parameters");
  }
}

void handleTalk() {
  if (server.hasArg("state")) {
    String state = server.arg("state");
    isSpeaking = (state == "on" || state == "1" || state == "true");
    server.send(200, "text/plain", isSpeaking ? "Speaking mode: ON" : "Speaking mode: OFF");
  } else {
    server.send(400, "text/plain", "Error: Missing 'state' parameter (on/off)");
  }
}

void handleDistance() {
  digitalWrite(TRIG_PIN, LOW);
  delayMicroseconds(2);
  digitalWrite(TRIG_PIN, HIGH);
  delayMicroseconds(10);
  digitalWrite(TRIG_PIN, LOW);
  
  // 30,000 microsecond timeout to prevent infinite freezes!
  long duration = pulseIn(ECHO_PIN, HIGH, 30000); 
  
  if (duration == 0) {
    server.send(200, "text/plain", "0.0");
  } else {
    float distance = (duration * 0.0343) / 2;
    server.send(200, "text/plain", String(distance));
  }
}

// ==========================================
// SETUP & MAIN LOOP
// ==========================================
void setup() {
  Serial.begin(115200);
  delay(100);

  // Initialize I2C
  Wire.begin(SDA_PIN, SCL_PIN);
  if (!pcf.begin(0x20, &Wire)) {
    Serial.println("ERROR: Could not find PCF8574!");
    while (1) { delay(1000); } 
  }
  
  pcf.pinMode(IN1, OUTPUT);
  pcf.pinMode(IN2, OUTPUT);
  pcf.pinMode(IN3, OUTPUT);
  pcf.pinMode(IN4, OUTPUT);
  stopMotors();

  // Initialize Ultrasonic Sensor
  pinMode(TRIG_PIN, OUTPUT);
  pinMode(ECHO_PIN, INPUT);

  // Initialize Display
  tft.initR(INITR_BLACKTAB);   
  tft.setRotation(1); // Landscape mode
  drawJarvisFace(currentEyeColor, false, false, false);

  // Initialize Wi-Fi
  WiFiManager wifiManager;
  bool res = wifiManager.autoConnect("JARVIS_Setup"); 

  if (!res) {
    ESP.restart();
  } 

  if (MDNS.begin("jarvis")) { 
    Serial.println("MDNS responder started: http://jarvis.local");
  }

  // Bind Web Routes
  server.on("/move", HTTP_GET, handleMove);
  server.on("/eyes", HTTP_GET, handleEyes);
  server.on("/talk", HTTP_GET, handleTalk); 
  server.on("/distance", HTTP_GET, handleDistance);
  
  server.begin();
  Serial.println("HTTP Server Started!");
  Serial.print("ESP32 IP: ");
  Serial.println(WiFi.localIP());
}

void loop() {
  server.handleClient();
  updateFaceAnimation(); 
}