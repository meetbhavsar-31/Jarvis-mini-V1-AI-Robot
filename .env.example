# =============================================================
# JARVIS MINI V2 -- environment variable template
#
# SECURITY FIX: the previous version of this file had two real, live Groq
# API keys and real WiFi IP addresses pasted directly into it -- and since
# this repo is publicly clonable, those keys were exposed on GitHub. If you
# are the owner: rotate/regenerate BOTH old Groq keys from
# https://console.groq.com immediately if you haven't already, treat them
# as burned. This file is not gitignored (only the real .env is, on
# purpose, so contributors know what variables exist) -- never put a real
# value in .env.example, only in your own local .env.
#
# Copy this file to .env and fill in your real values there:
#   cp .env.example .env
# =============================================================

# --- Robot hardware (both required) ---
# NOTE: these are almost always TWO DIFFERENT physical ESP32 boards --
# one for motors/eyes/speaker, one for the camera. Mixing them up is a
# common source of "robot is offline" confusion.
ESP32_IP=http://192.xx.x
ESP32_CAM_STREAM_URL=http://192.x.x.x/stream

# Both of the above can also be changed live from the dashboard's Settings
# page without restarting the server -- useful since these IPs commonly
# change after a router/DHCP renewal.

# --- AI engines ---
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL_PRIMARY=llama-3.3-70b-versatile
GROQ_MODEL_SECONDARY=gemma2-9b-it
GROQ_VISION_MODEL=qwen/qwen3.6-27b

GEMINI_API_KEY=your_gemini_api_key_here

OLLAMA_LOCAL_MODEL=qwen2.5:3b
# Requires Ollama running locally (https://ollama.com) with this model
# pulled: `ollama pull qwen2.5:3b`. Select "Local Offline" as the AI engine
# on the Settings page to prefer this over the cloud engines.

# --- Optional: live web search tool for the AI brain ---
TAVILY_API_KEY=

# --- Cloud storage (security snapshots) ---
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name

# --- Optional: news headlines for the morning briefing ---
NEWS_API_KEY=

# --- Optional: free real-time alerting (no paid plan needed) ---
# Configure one or both. See backend/src/jarvis/alerts/notifier.py for the
# 5-minute setup steps for each.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
NTFY_TOPIC=
NTFY_SERVER=https://ntfy.sh

# --- Optional: protects state-changing dashboard API routes ---
# If set, requests to protected endpoints (movement, memory edits, etc.)
# must include header: X-API-Token: <this value>. Leave blank to disable.
API_AUTH_TOKEN=

# --- Misc ---
DEFAULT_LANGUAGE=en
ENABLE_CLOUD_SYNC=false

# =============================================================
# Deprecated: config/camera.yaml is no longer read by the code (motion
# and vision config both come from the environment variables above, or
# live from the Settings page). If you still have that file, it's dead
# config at this point -- safe to ignore or delete.
# =============================================================
